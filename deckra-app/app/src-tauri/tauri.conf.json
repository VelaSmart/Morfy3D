{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DECKRA Control Center",
  "version": "0.1.0",
  "identifier": "com.velasmart.deckra",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DECKRA Control Center",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Configure seu controlador DECKRA",
    "longDescription": "Aplicativo de configuração do controlador físico DECKRA."
  }
}